# =======================================================
# Multi-Runner Docker Compose Environment Configuration
# =======================================================

# Organization-level runner settings
ORG_RUNNER_URL=https://github.com/my-org
ORG_RUNNER_TOKEN=ORG_REGISTRATION_TOKEN_HERE
ORG_RUNNER_NAME=
ORG_RUNNER_NAME_PREFIX=org-runner-
ORG_RUNNER_LABELS=org,docker,shared
ORG_RUNNER_GROUP=Default
# Host directory for Org runner workspace (must match identical path in container for DooD)
ORG_RUNNER_WORKDIR=/tmp/github-runner/org-work

# Repository-level runner settings
REPO_RUNNER_URL=https://github.com/my-org/my-project
REPO_RUNNER_TOKEN=REPO_REGISTRATION_TOKEN_HERE
REPO_RUNNER_NAME=
REPO_RUNNER_NAME_PREFIX=repo-runner-
REPO_RUNNER_LABELS=repo,docker,dedicated
# Host directory for Repo runner workspace (must match identical path in container for DooD)
REPO_RUNNER_WORKDIR=/tmp/github-runner/repo-work

# Optional Shared Cache Server configuration
ACTIONS_RESULTS_URL=http://cache-server:3000/
DISABLE_AUTO_UPDATE=false
