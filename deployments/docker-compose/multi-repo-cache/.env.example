# ==============================================================================
# Multi-Repository GitHub Runners with Shared Cache Server
# ==============================================================================

# ------------------------------------------------------------------------------
# Runner Image
# ------------------------------------------------------------------------------
# Image tag for GitHub Actions runners.
# Default: ghcr.io/bestony/self-hosted-action-runner:latest (no Docker Hub rate limits)
# Alternative: bestony/self-hosted-runner:latest
RUNNER_IMAGE=ghcr.io/bestony/self-hosted-action-runner:latest

# ------------------------------------------------------------------------------
# Shared Cache Server Configuration
# ------------------------------------------------------------------------------
# Published host port for the cache server.
CACHE_PORT=3000

# Base URL that runners use to reach the cache server (without trailing slash).
# IMPORTANT NETWORKING CAVEAT:
# - Normal workflow steps run inside the runner container and reach the cache
#   server via internal Docker DNS: http://cache-server:3000
# - If your workflows use `container:` jobs or Docker service containers, those
#   containers are launched by the runner on the HOST Docker daemon in a separate
#   network bridge and CANNOT resolve 'cache-server'.
# - For container jobs, set CACHE_URL to a host-reachable IP/domain:
#   CACHE_URL=http://192.168.1.50:3000
#   (both cache server API_BASE_URL and runner ACTIONS_RESULTS_URL must match).
CACHE_URL=http://cache-server:3000

# Cache retention settings
CACHE_CLEANUP_OLDER_THAN_DAYS=90
CACHE_FILESYSTEM_MAX_USAGE_PERCENT=90

# ------------------------------------------------------------------------------
# Repository A Runner Configuration
# ------------------------------------------------------------------------------
# Target repository URL
REPO_A_URL=https://github.com/my-org/repo-a

# Registration token from: Settings > Actions > Runners > New self-hosted runner
# Note: Tokens expire in 1 hour; only required for initial registration.
REPO_A_TOKEN=REPLACE_WITH_REPO_A_REGISTRATION_TOKEN

# Runner naming: prefix added to container hostname to avoid collisions on GitHub
REPO_A_NAME=
REPO_A_NAME_PREFIX=repo-a-
REPO_A_LABELS=self-hosted,linux,docker
REPO_A_GROUP=

# Host directory for Repository A runner workspace.
# For Docker-outside-of-Docker (DooD), host path and container path must be identical.
REPO_A_WORKDIR=/tmp/github-runner/repo-a-work

# ------------------------------------------------------------------------------
# Repository B Runner Configuration
# ------------------------------------------------------------------------------
# Target repository URL
REPO_B_URL=https://github.com/my-org/repo-b

# Registration token from: Settings > Actions > Runners > New self-hosted runner
REPO_B_TOKEN=REPLACE_WITH_REPO_B_REGISTRATION_TOKEN

REPO_B_NAME=
REPO_B_NAME_PREFIX=repo-b-
REPO_B_LABELS=self-hosted,linux,docker
REPO_B_GROUP=

# Host directory for Repository B runner workspace.
REPO_B_WORKDIR=/tmp/github-runner/repo-b-work

# ------------------------------------------------------------------------------
# Optional Settings
# ------------------------------------------------------------------------------
# Disable auto-updates (already automatically forced when ACTIONS_RESULTS_URL is set)
DISABLE_AUTO_UPDATE=false
LOG_LEVEL=info
