# ==========================================
# GitHub Self-Hosted Runner Configuration
# ==========================================

# Required: Target URL for registration
# For a repository runner:
RUNNER_URL=https://github.com/my-org/my-repo
# Or for an organization runner:
# RUNNER_URL=https://github.com/my-org

# Required: Registration token obtained from:
# Repository: Settings > Actions > Runners > New self-hosted runner
# Organization: Settings > Actions > Runners > New runner
RUNNER_TOKEN=AB12CD34EF56GH78IJ90KL

# Naming Precedence:
# 1. RUNNER_NAME (if set, used verbatim for runner-1; or set RUNNER_NAME_1, RUNNER_NAME_2, etc.)
# 2. RUNNER_NAME_PREFIX (resolved as "${RUNNER_NAME_PREFIX}${HOSTNAME}", defaults to runner-1-, runner-2-, etc.)
# 3. Default: container hostname (${HOSTNAME})

# Optional: Custom name for the runner
# RUNNER_NAME=my-custom-runner
# RUNNER_NAME_1=my-custom-runner-1
# RUNNER_NAME_2=my-custom-runner-2

# Optional: Base prefix for runner names (e.g. ci-runner-)
RUNNER_NAME_PREFIX=ci-runner-

# Optional: Work directory for jobs.
# CRITICAL for Docker-outside-of-Docker (DooD): when mounting /var/run/docker.sock, container jobs
# (e.g. `container:` steps or `uses: docker://...`) ask the host daemon to mount job workspaces.
# The host path and container path MUST be identical.
# By default each instance uses its own isolated workspace (${PWD}/work/runner-1, ${PWD}/work/runner-2, etc.)
# to allow fully concurrent task execution without file collisions.
# Individual overrides: RUNNER_WORKDIR_1, RUNNER_WORKDIR_2, etc.
RUNNER_WORKDIR=${PWD}/work/runner-1

# Optional: Comma-separated custom labels (e.g. gpu,fast,ubuntu-22.04)
RUNNER_LABELS=custom-runner,docker

# Optional: Organization runner group (default: Default)
RUNNER_GROUP=Default

# Optional: External GHA Cache Server URL (e.g. http://cache-server:3000/ or http://host.docker.internal:3000/)
# Must begin with http:// or https://. A trailing slash is automatically added if omitted.
# Note: Container jobs started via Docker socket are attached to host Docker bridge, so the URL
# must be resolvable and reachable from host network.
# Leave empty by default because cache-server only starts with '--profile cache',
# and setting this variable also forces runner self-updates to be disabled.
ACTIONS_RESULTS_URL=
# Example when running with --profile cache:
# ACTIONS_RESULTS_URL=http://cache-server:3000/

# Optional: Disable automatic runner updates from GitHub (defaults to true if ACTIONS_RESULTS_URL is set)
DISABLE_AUTO_UPDATE=false

# Optional: Logging level (debug | info | warn | error, default: info)
LOG_LEVEL=info

# Optional: Give root-owned files in the job workspace back to the runner user
# before and after each job (needed when jobs run containers as root). Default: true
FIX_WORKSPACE_OWNERSHIP=true
